<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Vibrator -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Camera -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Microphone -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Location / GPS -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- NFC -->
    <uses-permission android:name="android.permission.NFC" />

    <!-- Wi-Fi / network -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Bluetooth (legacy, <= API 30) -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <!-- Bluetooth (API 31+) -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        tools:targetApi="s" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"
        tools:targetApi="s" />

    <!-- Cellular / Telephony -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!-- Battery charge/discharge logging: keeps recording with the screen off -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"
        tools:targetApi="34" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"
        tools:targetApi="33" />

    <!-- Screenshot save to public Pictures (Elo Draw); API 29+ uses MediaStore (no permission) -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Hardware features: all optional so the app installs on any device.
         Actual presence is probed at runtime (HardwareDetector). -->
    <uses-feature android:name="android.hardware.nfc" android:required="false" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.wifi" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.gyroscope" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.compass" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.light" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.proximity" android:required="false" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-feature android:name="android.hardware.ethernet" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:roundIcon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.EloDeviceTester">

        <activity android:name=".MainActivity"
            android:screenOrientation="nosensor" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".modules.cpu.CpuActivity"
            android:screenOrientation="nosensor" />
        <activity android:name=".modules.ddr.DdrActivity"
            android:screenOrientation="nosensor" />
        <activity android:name=".modules.ddr.MemtesterActivity"
            android:screenOrientation="nosensor" />
        <activity android:name=".modules.ddr.QmesaActivity"
            android:screenOrientation="nosensor" />
        <activity android:name=".modules.storage.StorageActivity"
            android:screenOrientation="nosensor" />
        <activity android:name=".modules.nfc.NfcActivity"
            android:screenOrientation="nosensor" android:launchMode="singleTop" />
        <activity android:name=".modules.gps.GpsActivity"
            android:screenOrientation="nosensor" />
        <activity android:name=".modules.vibrator.VibratorActivity"
            android:screenOrientation="nosensor" />
        <activity android:name=".modules.display.DisplayActivity"
            android:screenOrientation="nosensor" />
        <activity android:name=".modules.display.EloColorPatternViewerActivity"
            android:screenOrientation="nosensor"
            android:theme="@style/Theme.EloDeviceTester.Fullscreen" />
        <activity android:name=".modules.display.EloColorPatternActivity"
            android:screenOrientation="nosensor" />
        <activity android:name=".modules.display.ColorTestActivity"
            android:screenOrientation="nosensor"
            android:theme="@style/Theme.EloDeviceTester.Fullscreen" />
        <activity android:name=".modules.display.GrayscaleActivity"
            android:screenOrientation="nosensor"
            android:theme="@style/Theme.EloDeviceTester.Fullscreen" />
        <activity android:name=".modules.display.ColorAccuracyActivity"
            android:screenOrientation="nosensor"
            android:theme="@style/Theme.EloDeviceTester.Fullscreen" />
        <activity android:name=".modules.display.MuraActivity"
            android:screenOrientation="nosensor"
            android:theme="@style/Theme.EloDeviceTester.Fullscreen" />
        <activity android:name=".modules.display.TouchAlignmentActivity"
            android:screenOrientation="nosensor"
            android:theme="@style/Theme.EloDeviceTester.Fullscreen" />
        <activity android:name=".modules.touch.TouchActivity"
            android:screenOrientation="nosensor" />
        <activity android:name=".modules.touch.MultiTouchActivity"
            android:screenOrientation="nosensor"
            android:theme="@style/Theme.EloDeviceTester.Fullscreen" />
        <activity android:name=".modules.touch.TouchGridActivity"
            android:screenOrientation="nosensor"
            android:theme="@style/Theme.EloDeviceTester.Fullscreen" />
        <activity android:name=".modules.touch.TouchSamplingActivity"
            android:screenOrientation="nosensor"
            android:theme="@style/Theme.EloDeviceTester.Fullscreen" />
        <activity android:name=".modules.touch.EloDrawActivity"
            android:screenOrientation="nosensor"
            android:theme="@style/Theme.EloDeviceTester.Fullscreen" />
        <activity android:name=".modules.touch.EloDrawSettingsActivity"
            android:screenOrientation="nosensor" />
        <activity android:name=".modules.audio.AudioActivity"
            android:screenOrientation="nosensor" />
        <activity android:name=".modules.camera.CameraActivity"
            android:screenOrientation="nosensor" />
        <activity android:name=".modules.wifibt.WifiBtActivity"
            android:screenOrientation="nosensor" />
        <activity android:name=".modules.sensors.SensorsActivity"
            android:screenOrientation="nosensor" />
        <activity android:name=".modules.battery.BatteryActivity"
            android:screenOrientation="nosensor" />
        <!-- Charge/discharge logger: diagnostic sampling that has to survive the
             screen going off, which no other foreground service type describes. -->
        <service
            android:name=".modules.battery.BatteryLogService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="battery charge/discharge diagnostic logging for after-sales inspection" />
        </service>
        <activity android:name=".modules.barcode.BarcodeActivity"
            android:screenOrientation="nosensor" />
        <activity android:name=".modules.msr.MsrActivity"
            android:screenOrientation="nosensor" />
        <activity android:name=".modules.serial.SerialActivity"
            android:screenOrientation="nosensor" />
        <activity android:name=".modules.displayext.DisplayExtActivity"
            android:screenOrientation="nosensor" />
        <activity android:name=".modules.ethernet.EthernetActivity"
            android:screenOrientation="nosensor" />
        <activity android:name=".modules.ethernet.IperfActivity"
            android:screenOrientation="nosensor" />
        <activity android:name=".modules.cellular.CellularActivity"
            android:screenOrientation="nosensor" />
        <activity android:name=".modules.stability.StabilityActivity"
            android:screenOrientation="nosensor" />
        <activity android:name=".modules.ping.PingActivity"
            android:screenOrientation="nosensor" />
        <activity android:name=".modules.ping.PingTestActivity"
            android:screenOrientation="nosensor" />
        <activity android:name=".modules.usbotg.UsbOtgActivity"
            android:screenOrientation="nosensor" />
        <activity android:name=".modules.cashdrawer.CashDrawerActivity"
            android:screenOrientation="nosensor" />
    </application>
</manifest>
